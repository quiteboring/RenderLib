{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "2D and 3D rendering libary for Minecraft",
  "authors": ["quiteboring"],
  "contact": {
    "homepage": "https://quiteboring.dev/",
    "sources": "https://github.com/quiteboring/RenderLib"
  },
  "license": "CC0-1.0",
  "icon": "assets/renderlib/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      {
        "value": "dev.quiteboring.renderlib.Main"
      }
    ]
  },
  "mixins": ["renderlib.mixins.json"],
  "depends": {
    "java": ">=25",
    "minecraft": "~${minecraftVersion}",
    "fabricloader": ">=${fabricLoaderVersion}"
  }
}
